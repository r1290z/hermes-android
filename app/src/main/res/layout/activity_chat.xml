<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <!-- One row, three things: back, title, actions. No pane controls, no
         tabs — those exist because the desktop needs them. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/app_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />

        <!-- In-chat search: the title and the search row share one slot; the
             search overlays the title while active. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/searchBar"
                layout="@layout/search_bar" />
        </FrameLayout>

        <!-- Current model, short form; tap opens the model picker. -->
        <TextView
            android:id="@+id/btnModel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip"
            android:drawableStart="@drawable/ic_model"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_secondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_search"
            android:src="@drawable/ic_search"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/session_actions"
            android:src="@drawable/ic_more"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Search results: a compact list under the header, above the transcript.
         No android:id here: giving the <include> an id REPLACES the root view's
         own id, so @+id/searchScroll disappeared and @+id/searchResults pointed
         at a ScrollView that the code casts to LinearLayout. -->
    <include layout="@layout/search_results" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <!-- Jump-to-bottom: shown only when the user has scrolled up during a
             running turn; tinted as "new" while content keeps arriving. -->
        <ImageButton
            android:id="@+id/btnDown"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="@string/scroll_down"
            android:src="@drawable/ic_down"
            android:visibility="gone" />

        <!-- Timeline chip: while the transcript is being scrolled it shows which
             moment is at the top of the screen, then fades out. A long session is
             otherwise a wall of text with no sense of where you are. -->
        <TextView
            android:id="@+id/timeline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Picked-but-unsent image: thumbnail with a remove cross. -->
    <FrameLayout
        android:id="@+id/attachPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/attachThumb"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/attached_image"
            android:scaleType="centerCrop" />

        <ImageButton
            android:id="@+id/attachRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end|top"
            android:background="#AA000000"
            android:contentDescription="@string/remove_image"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary" />
    </FrameLayout>

    <!-- Composer: field + send. The send button is always there (grey when the
         field is empty) instead of appearing on the first keystroke — a control
         that appears is a control the thumb has to hunt for. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_bg"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/attach_image"
            android:src="@drawable/ic_attach"
            android:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voice_input"
            android:src="@drawable/ic_mic"
            android:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:gravity="top|start"
            android:hint="@string/composer_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="6"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="15sp"
            android:autofillHints="" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/send"
            android:src="@drawable/ic_send"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/btnSteer"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/steer"
            android:src="@drawable/ic_steer"
            android:tint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
