<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_bubble_user"
        android:lineSpacingExtra="2dp"
        android:maxWidth="300dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textColor="@color/bubble_user_text"
        android:textSize="15sp"
        android:textIsSelectable="true" />

    <ImageView
        android:id="@+id/image"
        android:layout_width="220dp"
        android:layout_height="160dp"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/attached_image"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Attachment line under the bubble: name and size only, no contents. -->
    <TextView
        android:id="@+id/fileLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="3dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_chip"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Stamp under the bubble, not inside it: the bubble is the message, the
         time is metadata and should not compete with the text. -->
    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="3dp"
        android:paddingEnd="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />
</LinearLayout>
